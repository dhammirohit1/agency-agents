# Environment Configuration Template
# Copy this file to .env and fill in your actual API keys

# =============================================================================
# AI/LLM Configuration
# =============================================================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Optional: Local LLM (Ollama)
LOCAL_LLM_ENDPOINT=http://localhost:11434/api/generate

# =============================================================================
# Crypto Exchange APIs (START WITH TESTNET/SANDBOX!)
# =============================================================================

# Binance (Testnet: https://testnet.binance.vision)
BINANCE_API_KEY=your_binance_testnet_api_key
BINANCE_SECRET_KEY=your_binance_testnet_secret_key

# Coinbase (Sandbox: https://sandbox.exchange.coinbase.com)
COINBASE_API_KEY=your_coinbase_sandbox_api_key
COINBASE_SECRET_KEY=your_coinbase_sandbox_secret_key

# Kraken (Sandbox available)
KRAKEN_API_KEY=your_kraken_api_key
KRAKEN_SECRET_KEY=your_kraken_secret_key

# =============================================================================
# Freelance Platform APIs
# =============================================================================

# Upwork (https://www.upwork.com/developers)
UPWORK_API_KEY=your_upwork_api_key
UPWORK_API_SECRET=your_upwork_api_secret

# Fiverr (Limited API, may require manual setup)
FIVERR_API_KEY=your_fiverr_api_key

# Freelancer.com (https://www.freelancer.com/api/developers/)
FREELANCER_API_KEY=your_freelancer_api_key

# =============================================================================
# Telegram Bot Configuration
# =============================================================================

# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your Telegram User ID (get from @userinfobot)
TELEGRAM_ADMIN_USER_ID=your_telegram_user_id

# =============================================================================
# Payment Gateway Configuration
# =============================================================================

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# PayPal (https://developer.paypal.com/dashboard/applications)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_SECRET=your_paypal_secret

# =============================================================================
# Withdrawal Configuration
# =============================================================================

# Crypto wallet for withdrawals
WITHDRAWAL_WALLET_ADDRESS=your_crypto_wallet_address

# =============================================================================
# Database Configuration
# =============================================================================

# SQLite (default, good for testing)
DATABASE_URL=sqlite:///auto_income.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/auto_income

# Redis for caching
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Debug & Mode Settings
# =============================================================================

# Enable debug logging
DEBUG_MODE=False

# Start in test mode (recommended - uses sandbox/testnet APIs)
TEST_MODE=True

# Set to False when ready for real operations
PRODUCTION_MODE=False

# =============================================================================
# Optional: Additional Services
# =============================================================================

# YouTube Data API (for content agent)
YOUTUBE_API_KEY=your_youtube_api_key

# TikTok API (if available)
TIKTOK_API_KEY=your_tiktok_api_key

# WhatsApp Business API
WHATSAPP_BUSINESS_TOKEN=your_whatsapp_token

# Email Service (SendGrid, etc.)
SENDGRID_API_KEY=your_sendgrid_api_key

# =============================================================================
# Immigration/Lead Gen Specific (Your Specialty)
# =============================================================================

# Website/Form integration
WEBHOOK_URL=https://your-domain.com/webhook

# CRM Integration (optional)
CRM_API_KEY=your_crm_api_key

# SMS Gateway (Twilio, etc.)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+your_twilio_phone_number
